[Unit]
Description=hop — агент
Documentation=https://github.com/shafed/hop
# Порядка относительно hopd.service здесь нет и быть не может: юниты живут в
# разных менеджерах (системном и пользовательском), и выразить «после сервиса»
# нечем. Агент, стартовавший раньше сокета, отваливается и приходит снова —
# отсюда Restart ниже.

[Service]
Type=exec
ExecStart=@BINDIR@/hop up
Restart=on-failure
RestartSec=2s

# Плановый уход — SIGTERM: агент успевает сказать сервису Detach, и окно отказа
# схлопывается до времени рестарта вместо orphan_deadline (§6.2). KillMode по
# умолчанию шлёт ровно его, поэтому здесь ничего не переопределяется.

[Install]
# §6.13: агент — при логине пользователя. Автоподключение к последнему
# активному профилю делает сам агент при старте; юнит отвечает только за то,
# что агент вообще запустился, и выключается штатным `systemctl --user disable`.
WantedBy=default.target
