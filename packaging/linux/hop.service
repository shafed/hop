[Unit]
Description=hop — агент
Documentation=https://github.com/shafed/hop
# Системный юнит, а не пользовательский. §6.13: агент стартует при старте ОС,
# логина не ждёт и с логаутом не умирает — он работает под системным
# пользователем @USER@, а не под тем, кто сел за машину.
#
# After даёт лишь порядок запуска, но не гарантию: сокет сервиса поднимается
# асинхронно, и агент вполне может прийти раньше. Отвалившийся агент приходит
# снова — отсюда Restart ниже.
After=@DAEMON_UNIT@
Wants=@DAEMON_UNIT@

[Service]
Type=exec
ExecStart=@BINDIR@/hop -group @GROUP@ up
Restart=on-failure
RestartSec=2s

# §1 С1 и §6.8: собственный UID агента — условие корректности правила §6.8.
# Под UID человека это правило выводит мимо туннеля человека целиком (C25).
User=@USER@
Group=@GROUP@

# §2 и §6.14: стор — системный каталог, владелец @USER@, права 0700. Заводит
# его systemd до старта агента: под своим UID агент в /var/lib не пишет.
StateDirectory=hop
StateDirectoryMode=0700

# §3.3: /run/hop — общий каталог, в нём сокет клиентов. Каталог открыт на
# чтение всем, а доступ гейтит сам сокет правами группы @GROUP@ (0660):
# каталог, открытый группе, открыл бы ей заодно и attach-token, а §6.14
# требует обратного. Токен поэтому лежит в приватном подкаталоге 0700, который
# агент создаёт сам.
RuntimeDirectory=hop
RuntimeDirectoryMode=0755

# Агент непривилегирован (§5.2): все привилегии живут в hopd. Ни одной
# capability ему не выдаётся, и получить их он не может.
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

# Плановый уход — SIGTERM: агент успевает сказать сервису Detach, и окно отказа
# схлопывается до времени рестарта вместо orphan_deadline (§6.2). KillMode по
# умолчанию шлёт ровно его, поэтому здесь ничего не переопределяется.

[Install]
WantedBy=multi-user.target
