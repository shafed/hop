# hopd — привилегированный сервис (§5.2, §6.2). Системный unit: сервис
# стартует при старте ОС, §6.13.
#
# ЧТО ЭТОТ ФАЙЛ НАМЕРЕННО НЕ ДЕЛАЕТ И ПОЧЕМУ
#
# 1. Не передаёт ни одного флага. Все значения, которые здесь были бы нужны
#    (-socket /run/hop.sock, -group hop), — это умолчания самого hopd
#    (cmd/hopd/main.go). Переписать их сюда значит завести второй источник
#    истины о пути сокета и об имени группы: продукт поменяет умолчание, unit
#    останется со старым значением, и оба будут «правильными» по отдельности.
#    Связь «группа, которую заводит инсталлятор» ↔ «группа, которой hopd
#    открывает сокет» держит охрана, а не совпадение строк:
#    internal/packaging/units_test.go.
#
# 2. Не объявляет Type=notify. Готовность выражать нечем: sd_notify в hopd нет,
#    сокет-активации нет (HANDOFF.json → autostart_decision.facts_that_shaped_it,
#    факт 2). Type=exec — честный максимум: systemd считает сервис запущенным
#    после успешного exec, то есть ДО того, как открыт /run/hop.sock. Разница
#    видна не здесь, а в hop-agent.service: пользовательский unit не умеет
#    упорядочиваться относительно системного вовсе, поэтому окно «агент
#    стартовал раньше сокета» закрывается в продукте, а не в unit-файлах.
#
# 3. Не содержит ни одной директивы песочницы (ProtectSystem, PrivateTmp,
#    CapabilityBoundingSet и прочих). hopd открывает /dev/net/tun и зовёт `ip`
#    (internal/platform/linux.go, internal/netstate/linux.go), то есть каждая
#    такая директива способна превратить fail-close в fail-broken. Проверить их
#    здесь нечем: systemd-analyze verify разбирает синтаксис, а не последствия,
#    а настоящая установка на машину разработчика запрещена. Ужесточение
#    приезжает вместе с CI-задачей, которая ставит пакет на одноразовый раннер и
#    смотрит на результат.
[Unit]
Description=hop — привилегированный сервис туннеля
# hopd снимает снапшот сети при старте и сверяет его при выходе (§8.4). Чем
# позже относительно настройки сети он стартует, тем устойчивее эта база;
# network.target — обычная точка «сеть настраивается» и не тянет за собой
# network-online.target, который на машине без wait-online не наступает вовсе.
After=network.target

[Service]
Type=exec
ExecStart=/usr/bin/hopd
# on-failure, а не always: штатная остановка (`systemctl stop`, SIGTERM при
# выключении машины) обязана остаться остановкой. Падение — наоборот, чинится
# перезапуском: hopd при старте сам снимает правила, пережившие прошлый запуск
# (platform.Reclaim, cmd/hopd/main.go), поэтому второй запуск начинается с
# чистой сети, а не поверх мусора первого.
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=multi-user.target
